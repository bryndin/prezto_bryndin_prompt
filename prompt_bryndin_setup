# My custom 2-line prompt
#
# Features:
#   - Full terminal width top line to visually separate different runs
#   - Current time
#   - Current user
#   - Host (only shown on remote machines)
#   - Active Python virtualenv
#   - Git info
#   - Current directory (shortened if too long)
#
# Authors:
#   Dmitry Bryndin <bryndin@gmail.com>
#
# Screenshots:
#   http://i.imgur.com/b2M5eOw.png?1
#

# All internal state is namespaced so switching themes cannot leak globals.
typeset -g  _prompt_bryndin_color='cyan'
typeset -g  _prompt_bryndin_time_color='27'   # light blue
typeset -g  _prompt_bryndin_host_color='27'   # light blue
typeset -g  _prompt_bryndin_virtualenv_color='yellow'
typeset -g  _prompt_bryndin_dir_color='33'    # brighter light blue
typeset -g  _prompt_bryndin_left=''
typeset -g  _prompt_bryndin_right=''
typeset -g  _prompt_bryndin_cur_dir=''
typeset -g  _prompt_bryndin_filler_width=0

# Load dependencies.
pmodload 'helper' 'python' 'git'

function prompt_bryndin_prepare_full_pwd {
  [[ -w $PWD ]] && print -n '%d' || print -n '%F{red}%d%f'
}

function prompt_bryndin_prepare_compressed_pwd {
  local pwd="${PWD/#$HOME/~}"

  if [[ "$pwd" == (#m)[/~] ]]; then
    print -n "$MATCH"
    unset MATCH
  else
    print -n "${${${(@j:/:M)${(@s:/:)pwd}##.#?}:h}%/}/${pwd:t}"
  fi
}

function prompt_bryndin_prepare_header {
  # do all substitutions and expansions
  local left=${(e)_prompt_bryndin_left}
  local right=${(e)_prompt_bryndin_right}

  # Pattern listing visual modifiers
  local zero='%([BSUbfksu]|([FB]|){*})'

  # remove non-printable prompt_color characters to compute length correctly
  local left_width=${#${(S%%)left//$~zero/}}
  local right_width=${#${(S%%)right//$~zero/}}

  _prompt_bryndin_filler_width=$(( $COLUMNS - $left_width - $right_width ))
}

function prompt_bryndin_precmd {
  setopt LOCAL_OPTIONS

  # Format PWD.
  _prompt_bryndin_cur_dir="$(prompt_bryndin_prepare_full_pwd)"

  # Get Git repository information.
  (( $+functions[git-info] )) && git-info

  # Get Virtualenv information. 
  python-info

  # Prepare header line
  prompt_bryndin_prepare_header

  local filler=""
  # fallback to compressed PWD if blocks aren't fitting
  [[ _prompt_bryndin_filler_width -lt 0 ]] && _prompt_bryndin_cur_dir="$(prompt_bryndin_prepare_compressed_pwd)" && prompt_bryndin_prepare_header
  [[ _prompt_bryndin_filler_width -gt 0 ]] && filler="${(l:${_prompt_bryndin_filler_width}::─:)}"

  # print with expansion
  print -P "${_prompt_bryndin_left}%F{$_prompt_bryndin_color}${filler}%f${_prompt_bryndin_right}"
}

function prompt_bryndin_setup {
  setopt LOCAL_OPTIONS
  unsetopt XTRACE KSH_ARRAYS
  prompt_opts=(cr percent subst)

  # Load required functions.
  autoload -Uz add-zsh-hook

  # Add hook for calling git-info before each command.
  add-zsh-hook precmd prompt_bryndin_precmd

  # Required for the editor module to populate editor_info (see
  # modules/prompt/README.md): without it the second prompt line is empty.
  zstyle ':prezto:module:prompt' managed 'yes'

  # Set editor-info parameters.
  zstyle ':prezto:module:editor:info:completing' format '%B%F{red}...%f%b'
  zstyle ':prezto:module:editor:info:keymap:primary' format '%B%F{red}❯%F{yellow}❯%F{green}❯%f%b'
  zstyle ':prezto:module:editor:info:keymap:primary:overwrite' format '%F{red}♺%f'
  zstyle ':prezto:module:editor:info:keymap:alternate' format '%B%F{green}❮%F{yellow}❮%F{red}❮%f%b'

  # Set git-info parameters.
  zstyle ':prezto:module:git:info' verbose 'yes'
  zstyle ':prezto:module:git:info:action' format ':%%B%F{yellow}%s%f%%b'
  zstyle ':prezto:module:git:info:added' format ' %%B%F{green}✚%f%%b'
  zstyle ':prezto:module:git:info:ahead' format ' %%B%F{yellow}⬆%f%%b'
  zstyle ':prezto:module:git:info:behind' format ' %%B%F{yellow}⬇%f%%b'
  zstyle ':prezto:module:git:info:branch' format ':%F{green}%b%f'
  zstyle ':prezto:module:git:info:commit' format ':%F{green}%.7c%f'
  zstyle ':prezto:module:git:info:deleted' format ' %%B%F{red}✖%f%%b'
  zstyle ':prezto:module:git:info:modified' format ' %%B%F{blue}✱%f%%b'
  zstyle ':prezto:module:git:info:position' format ':%F{red}%p%f'
  zstyle ':prezto:module:git:info:renamed' format ' %%B%F{magenta}➜%f%%b'
  zstyle ':prezto:module:git:info:stashed' format ' %%B%F{cyan}✭%f%%b'
  zstyle ':prezto:module:git:info:unmerged' format ' %%B%F{yellow}═%f%%b'
  zstyle ':prezto:module:git:info:untracked' format ' %%B%F{white}◼%f%%b'
  # Keep $(coalesce ...) quoted so it is evaluated by ${(e)git_info[prompt]}
  # *after* git-info's zformat has substituted %b/%p/%c.  Using double quotes
  # here would run it at setup time with three literal, non-empty arguments.
  zstyle ':prezto:module:git:info:keys' format \
    'prompt' '%F{'$_prompt_bryndin_color'}(%F{blue}git%f$(coalesce "%b" "%p" "%c")%s%A%B%S%a%d%m%r%U%u%F{'$_prompt_bryndin_color'})%f'

  # Set python-info (virtualenv) parameters. 
  zstyle ':prezto:module:python:info:virtualenv' format "%F{$_prompt_bryndin_color}─<%F{$_prompt_bryndin_virtualenv_color}%v%F{$_prompt_bryndin_color}>%f"

  ### Header blocks
  local time='%T'
  local time_block="%F{$_prompt_bryndin_color}─(%F{$_prompt_bryndin_time_color}${time}%F{$_prompt_bryndin_color})%f"

  local host=''
  [[ -n $SSH_CLIENT ]] && host='%F{$_prompt_bryndin_host_color}@%m%f'
  local host_block="%F{$_prompt_bryndin_color}─(%f%(!.%F{red}%n%f.%F{$_prompt_bryndin_host_color}%n%f$host)%F{$_prompt_bryndin_color})%f"

  local git_block='${git_info:+${(e)git_info[prompt]}}'

  local virtualenv_block='${python_info[virtualenv]}'

  local dir_block='%F{$_prompt_bryndin_color}[%F{$_prompt_bryndin_dir_color}${_prompt_bryndin_cur_dir}%F{$_prompt_bryndin_color}]─%f'

  # Define prompts
  _prompt_bryndin_left="${time_block}${host_block}${virtualenv_block}${git_block}"
  _prompt_bryndin_right="${dir_block}"
  PROMPT='%(!. %B%F{red}#%f%b.)${editor_info[keymap]}'
  SPROMPT='zsh: correct %F{red}%R%f to %F{green}%r%f [nyae]? '

  # Disable VirtualEnv prompt
  VIRTUAL_ENV_DISABLE_PROMPT=1
}

prompt_bryndin_setup "$@"
