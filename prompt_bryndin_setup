# My custom 2-line prompt
#
# Features:
#   - Full terminal width top line to visually separate different runs
#   - Current time
#   - Current user
#   - Host (only shown on remote machines)
#   - Active Python virtualenv
#   - Git info
#   - Current directory (shortened if too long)
#
# Authors:
#   Dmitry Bryndin <bryndin@gmail.com>
#
# Screenshots:
#   http://i.imgur.com/b2M5eOw.png?1
#

# All internal state is namespaced so switching themes cannot leak globals.
typeset -gA _prompt_bryndin_conf
typeset -gA _prompt_bryndin_fg
typeset -gA _prompt_bryndin_block_text
typeset -gA _prompt_bryndin_block_expanded
typeset -ga _prompt_bryndin_blocks
typeset -g  _prompt_bryndin_monochrome=0
typeset -g  _prompt_bryndin_cmd_start=0
typeset -g  _prompt_bryndin_duration_text=''
typeset -g  _prompt_bryndin_last_status=0
typeset -g  _prompt_bryndin_status_text=''
typeset -g  _prompt_bryndin_git=''
typeset -g  _prompt_bryndin_venv=''
typeset -g  _prompt_bryndin_async=0
typeset -g  _prompt_bryndin_left=''
typeset -g  _prompt_bryndin_right=''
typeset -g  _prompt_bryndin_left_expanded=''
typeset -g  _prompt_bryndin_right_expanded=''
typeset -g  _prompt_bryndin_header=''
typeset -g  _prompt_bryndin_cur_dir=''
typeset -g  _prompt_bryndin_filler_width=0
typeset -g  _prompt_bryndin_overflow=0
typeset -g  _prompt_bryndin_trapwinch_installed=0
typeset -g  _prompt_bryndin_had_trapwinch=0
typeset -g  _prompt_bryndin_saved_trapwinch=''

#
# Every option is a zstyle under ':prezto:module:prompt:bryndin'.  Defaults are
# declared here and overridden from .zpreztorc, so users never need to edit the
# theme file.  See README.md for the full list.
#
function prompt_bryndin_load_config {
  emulate -L zsh
  # NOTE: Prezto reserves the style name `color' for its global
  # `zstyle ":prezto:*:*" color "yes"' setting, and zstyle patterns match
  # across colons.  Never name a theme option `color' (or `case-sensitive'):
  # it would inherit the framework value.  Hence `main-color'.
  _prompt_bryndin_conf=(
    main-color        'cyan'
    time-color        '27'
    host-color        '27'
    virtualenv-color  'yellow'
    dir-color         '33'
    git-color         'blue'
    error-color       'red'
    separator         '─'
    separator-color   ''
    time-format       '%T'
    host              'auto'
    pwd               'prompt-pwd'
    compressed-pwd    ''
    colors            'auto'
    max-block-width   '0'
    async             'no'
    exit-status       'yes'
    jobs              'yes'
    history           'no'
    duration          'no'
    vim               'yes'
    overwrite         'yes'
    keymap-indicator  'no'
    single-line       'no'
    show-return-code  'no'
  )

  local key value
  for key in ${(k)_prompt_bryndin_conf}; do
    value=''
    zstyle -s ":prezto:module:prompt:bryndin" "$key" value \
      && _prompt_bryndin_conf[$key]="$value"
  done

  # `pwd' is the historical name for the compressed fallback; keep it as an
  # alias while `compressed-pwd' provides the explicit name.
  [[ -n $_prompt_bryndin_conf[compressed-pwd] ]] || \
    _prompt_bryndin_conf[compressed-pwd]=$_prompt_bryndin_conf[pwd]

  _prompt_bryndin_blocks=()
  zstyle -a ':prezto:module:prompt:bryndin' blocks _prompt_bryndin_blocks \
    || _prompt_bryndin_blocks=(time host virtualenv git)

  # Honour the framework-wide style for printing the numeric exit code.
  zstyle -t ':prezto:module:prompt' show-return-val \
    && _prompt_bryndin_conf[show-return-code]='yes'

}

# Colour escapes contributed by framework formats (git-info, editor-info).
typeset -g _prompt_bryndin_color_pat='%([fk]|([FK]){*})'

#
# Remove colour escapes from a prompt string so monochrome mode also covers
# text supplied by framework zstyles rather than built by this theme.
#
function prompt_bryndin_strip_colors {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local s=$1
  print -rn -- "${(S)s//$~_prompt_bryndin_color_pat/}"
}

#
# Resolve one configured colour spec into a %F{...} prompt escape, or into an
# empty string when colours are disabled.  Numeric 256-colour indices are
# downgraded to the nearest basic colour on terminals that cannot display them.
#
function prompt_bryndin_color_escape {
  emulate -L zsh
  local spec=$1
  (( _prompt_bryndin_monochrome )) && return 0

  local mode=$_prompt_bryndin_conf[colors]
  local ncolors=${terminfo[colors]:-0}
  local downgrade=0
  [[ $mode == 16 ]] && downgrade=1
  [[ $mode == auto && $ncolors -lt 256 ]] && downgrade=1

  if [[ $spec == <-> ]] && (( downgrade )); then
    # 0-15 are already standard ANSI colours and need no conversion.
    if (( spec >= 16 && spec < 232 )); then
      local idx=$(( spec - 16 ))
      local r=$(( idx / 36 )) g=$(( (idx / 6) % 6 )) b=$(( idx % 6 ))
      spec=$(( (r >= 2) + 2 * (g >= 2) + 4 * (b >= 2) ))
    elif (( spec >= 232 && spec < 256 )); then
      # Grayscale ramp: dark shades become bright black, light ones white.
      spec=$(( spec < 244 ? 8 : 7 ))
    elif (( spec >= 256 )); then
      spec='default'
    fi
  fi
  print -rn -- "%F{$spec}"
}

function prompt_bryndin_build_colors {
  emulate -L zsh
  # Own the style reload here so the colour layer is self-contained and does
  # not depend on who called setup.
  prompt_bryndin_load_config
  local mode=$_prompt_bryndin_conf[colors]
  _prompt_bryndin_monochrome=0
  [[ $mode == none || -n $NO_COLOR || $TERM == dumb ]] && _prompt_bryndin_monochrome=1

  typeset -gA _prompt_bryndin_fg
  _prompt_bryndin_fg=()
  local key
  for key in main-color time-color host-color virtualenv-color dir-color git-color error-color; do
    _prompt_bryndin_fg[$key]=$(prompt_bryndin_color_escape "$_prompt_bryndin_conf[$key]")
  done
  _prompt_bryndin_fg[separator-color]=$(prompt_bryndin_color_escape \
    "${_prompt_bryndin_conf[separator-color]:-$_prompt_bryndin_conf[main-color]}")
  if (( _prompt_bryndin_monochrome )); then
    _prompt_bryndin_fg[reset]=''
  else
    _prompt_bryndin_fg[reset]='%f'
  fi
}

# These associative arrays are populated by git-info, python-info and
# editor-info.  Declare them so the theme still renders cleanly when one of
# those modules is unavailable (an unset scalar with a [subscript] is parsed as
# arithmetic and throws "bad math expression").
typeset -gA git_info python_info editor_info

# Load dependencies.
pmodload 'helper' 'python' 'git'

#
# Escape plain text for safe embedding in a prompt string.  '%' would
# otherwise be interpreted as a prompt escape by the expansion pass; '$', '\'
# and backticks are escaped too for defence in depth.  A character loop is used
# deliberately: nested ${...//...} replacements are easy to get wrong here.
#
function prompt_bryndin_escape {
  emulate -L zsh
  local str=$1
  str=${str//\\/\\\\}
  str=${str//\%/\%\%}
  str=${str//\$/\\\$}
  str=${str//\`/\\\`}
  print -rn -- "$str"
}

#
# Build the virtualenv block from the environment variables directly, so the
# name can be escaped.  (python-info's %v format inserts it verbatim.)
#
function prompt_bryndin_prepare_virtualenv {
  emulate -L zsh
  local name=${VIRTUAL_ENV:t}
  [[ -z $name ]] && name=$CONDA_DEFAULT_ENV
  [[ -z $name ]] && return 0
  local safe=$(prompt_bryndin_escape "$name")
  print -rn -- "${_prompt_bryndin_fg[main-color]}─<${_prompt_bryndin_fg[virtualenv-color]}${safe}${_prompt_bryndin_fg[main-color]}>${_prompt_bryndin_fg[reset]}"
}

#
# Clip plain text to N display columns, appending an ellipsis.  ${#...} counts
# characters, not terminal columns, so wide (e.g. CJK) glyphs are measured
# with ${(m)#...} instead.
#
function prompt_bryndin_clip {
  emulate -L zsh
  local text=$1 max=$2
  (( max <= 0 )) && { print -rn -- "$text"; return 0 }
  (( ${(m)#text} <= max )) && { print -rn -- "$text"; return 0 }

  local -a chars=( ${(s::)text} )
  local out='' c width=0 cw
  for c in $chars; do
    cw=${(m)#c}
    (( width + cw > max - 1 )) && break
    out+=$c
    (( width += cw ))
  done
  print -rn -- "${out}…"
}

#
# Decide whether to show the hostname.  `auto' detects SSH (via any of the
# variables different sshd versions set) and su/sudo to another account.
#
function prompt_bryndin_is_remote {
  emulate -L zsh
  case $_prompt_bryndin_conf[host] in
    yes|always) return 0 ;;
    no|never)   return 1 ;;
  esac
  [[ -n $SSH_TTY || -n $SSH_CLIENT || -n $SSH_CONNECTION ]] && return 0
  local login=${$(command logname 2>/dev/null):-$USER}
  [[ -n $login && $login != $USER ]] && return 0
  return 1
}

function prompt_bryndin_prepare_full_pwd {
  # %~ abbreviates $HOME, matching the compressed representation.  It is a
  # prompt escape, so zsh resolves it at draw time and prompt_bryndin_measure
  # expands it when computing the width.
  if [[ -w $PWD ]]; then
    print -n -- '%~'
  else
    print -n -- "${_prompt_bryndin_fg[error-color]}%~${_prompt_bryndin_fg[reset]}"
  fi
}

#
# Is Prezto's prompt-pwd helper actually available?  autoload marks a function
# as defined even when its file is missing, so check fpath explicitly.
#
function prompt_bryndin_has_prompt_pwd {
  emulate -L zsh
  local dir
  for dir in $fpath; do
    [[ -r $dir/prompt-pwd ]] && return 0
  done
  return 1
}

#
# Produce the (%-escaped, clipped) directory text used when the full path does
# not fit.  `compressed-pwd' selects the strategy; the default delegates to
# Prezto's prompt-pwd, which honours the framework-wide
# ':prezto:module:prompt' pwd-length style.  `pwd' remains a compatibility
# alias for `compressed-pwd'.
#
function prompt_bryndin_pwd_text {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local style=$_prompt_bryndin_conf[compressed-pwd]
  local max=${1:-$_prompt_bryndin_conf[max-block-width]}
  local text

  case $style in
    full)
      text=$PWD
      ;;
    tilde)
      text=${PWD/#$HOME/\~}
      ;;
    *)
      if prompt_bryndin_has_prompt_pwd; then
        text=$(prompt-pwd)
        text=${text//\%\%/\%}   # prompt-pwd escapes '%' for prompt strings
      else
        local pwd="${PWD/#$HOME/~}"
        if [[ "$pwd" == (#m)[/~] ]]; then
          text="$MATCH"
          unset MATCH
        else
          text="${${${(@j:/:M)${(@s:/:)pwd}##.#?}:h}%/}/${pwd:t}"
        fi
      fi
      ;;
  esac

  (( max > 0 )) && text=$(prompt_bryndin_clip "$text" "$max")
  print -rn -- "${text//\%/%%}"
}

function prompt_bryndin_prepare_compressed_pwd {
  local text=$(prompt_bryndin_pwd_text "$1")

  # Keep the "no write permission" highlight in the compressed representation
  # too; otherwise the feature silently disappears on long paths.
  if [[ -w $PWD ]]; then
    print -rn -- "$text"
  else
    print -rn -- "${_prompt_bryndin_fg[error-color]}${text}${_prompt_bryndin_fg[reset]}"
  fi
}

#
# Compute the visible width of two already-expanded prompt strings and derive
# the filler width.  Zero-width prompt escapes are stripped first.
#
function prompt_bryndin_measure {
  emulate -L zsh
  local left=$1 right=$2
  local zero='%([BSUbfksu]|([FBK]|){*})'
  local left_width=${(m)#${(S%%)left//$~zero/}}
  local right_width=${(m)#${(S%%)right//$~zero/}}

  # Never produce a negative filler (which would make the padding expression
  # fail and leave the header wider than the terminal).  Track the overflow
  # separately: it drives the compressed-PWD fallback and block clipping.
  local width=$(( $COLUMNS - $left_width - $right_width ))
  _prompt_bryndin_filler_width=$(( width > 0 ? width : 0 ))
  _prompt_bryndin_overflow=$(( width < 0 ? -width : 0 ))
}

function prompt_bryndin_prepare_header {
  # Expand the deferred ${...} blocks exactly once and cache the result.  The
  # per-block copies let reflow drop whole blocks without cutting through a
  # prompt escape sequence.
  local block expanded left=''
  _prompt_bryndin_block_expanded=()
  for block in $_prompt_bryndin_blocks; do
    expanded=${(e)_prompt_bryndin_block_text[$block]}
    _prompt_bryndin_block_expanded[$block]=$expanded
    left+=$expanded
  done

  local right=${(e)_prompt_bryndin_right}
  _prompt_bryndin_left_expanded=$left
  _prompt_bryndin_right_expanded=$right
  prompt_bryndin_measure "$left" "$right"
}

#
# Build the header string from the cached blocks.  This is cheap and can be
# called again on a redraw (e.g. after a terminal resize) without re-running
# git-info or re-evaluating the block templates.
#
function prompt_bryndin_reflow {
  emulate -L zsh
  local left=$_prompt_bryndin_left_expanded
  local right=$_prompt_bryndin_right_expanded
  prompt_bryndin_measure "$left" "$right"

  # If the blocks still do not fit (very narrow terminal), drop whole blocks
  # from the right of the configured order.  Clipping the string itself would
  # risk cutting through a prompt escape sequence.
  if (( _prompt_bryndin_overflow > 0 )); then
    local -a active=($_prompt_bryndin_blocks)
    local block
    while (( _prompt_bryndin_overflow > 0 && $#active > 0 )); do
      active[-1]=()
      left=''
      for block in $active; do left+=$_prompt_bryndin_block_expanded[$block]; done
      prompt_bryndin_measure "$left" "$right"
    done
  fi

  # Repeat the separator to fill the available display columns.  A plain loop
  # (rather than ${(l:...:)}) keeps the separator configurable and lets us
  # account for double-width glyphs.
  local sep=${_prompt_bryndin_conf[separator]}
  local sep_escaped=${sep//\%/%%}
  local sep_width=${(m)#sep}
  (( sep_width < 1 )) && sep_width=1
  local count=$(( _prompt_bryndin_filler_width / sep_width ))
  local filler='' i
  for (( i = 0; i < count; i++ )); do filler+=$sep_escaped; done
  _prompt_bryndin_header="${left}${_prompt_bryndin_fg[separator-color]}${filler}${_prompt_bryndin_fg[reset]}${right}"
  (( _prompt_bryndin_monochrome )) && \
    _prompt_bryndin_header=$(prompt_bryndin_strip_colors "$_prompt_bryndin_header")
  return 0
}

#
# Runs inside the async worker.  Prints the fully rendered git block; the
# callback stores it in _prompt_bryndin_git and redraws the prompt.
#
function prompt_bryndin_async_git {
  emulate -L zsh
  cd -q "$1" 2>/dev/null || return 1
  (( $+functions[git-info] )) || return 1
  git-info || return 1
  print -r -- "${(e)git_info[prompt]}"
}

function prompt_bryndin_async_callback {
  emulate -L zsh

  # zsh-async reports worker failures as [async]. Stop using the worker and
  # fall back to synchronous git collection instead of printing errors on
  # every prompt.
  if [[ $1 == '[async]' ]]; then
    _prompt_bryndin_async=0
    return 0
  fi

  [[ $1 == prompt_bryndin_async_git ]] || return 0
  local rendered=$3
  [[ $rendered == $_prompt_bryndin_git ]] && return 0
  _prompt_bryndin_git=$rendered
  prompt_bryndin_prepare_header
  prompt_bryndin_reflow
  # Only redraw when zle is active (the callback also fires in scripts).
  zle && zle reset-prompt
}

function prompt_bryndin_preexec {
  # Clear the previous command's status as soon as a new command is accepted.
  _prompt_bryndin_status_text=''
  _prompt_bryndin_cmd_start=$SECONDS
}

# Runs first in the precmd chain, before other hooks can overwrite $?. The
# prompt's %( ?..) indicator must reflect the user's last command, not the
# status of a highlight/autosuggestion/precmd helper.
function prompt_bryndin_precmd_status {
  _prompt_bryndin_last_status=$?
}

function prompt_bryndin_precmd {
  setopt LOCAL_OPTIONS EXTENDED_GLOB

  # Command duration (integer seconds; cleared after each command).
  if (( _prompt_bryndin_cmd_start > 0 )); then
    local elapsed=$(( SECONDS - _prompt_bryndin_cmd_start ))
    _prompt_bryndin_cmd_start=0
    (( elapsed > 0 )) && _prompt_bryndin_duration_text="${elapsed}s " \
      || _prompt_bryndin_duration_text=''
  else
    _prompt_bryndin_duration_text=''
  fi

  # Format PWD.
  _prompt_bryndin_cur_dir="$(prompt_bryndin_prepare_full_pwd)"

  # Get Git repository information.  In async mode the worker renders the
  # block and the callback updates it; otherwise do it here synchronously.
  if (( _prompt_bryndin_async )); then
    if ! zpty -t prompt_bryndin &>/dev/null; then
      _prompt_bryndin_async=0
    else
      # Drop queued jobs from previous directories so rapid cd commands do not
      # build a backlog of obsolete git queries.
      (( $+functions[async_flush_jobs] )) && \
        async_flush_jobs prompt_bryndin 2>/dev/null
      if ! async_job prompt_bryndin prompt_bryndin_async_git "$PWD"; then
        _prompt_bryndin_async=0
      fi
    fi
  fi

  if (( ! _prompt_bryndin_async )); then
    (( $+functions[git-info] )) && git-info
    _prompt_bryndin_git=''
    [[ -n $git_info[prompt] ]] && _prompt_bryndin_git=${(e)git_info[prompt]}
  fi

  # Get Virtualenv information. The python module returns early when no Python
  # interpreter is installed, so python-info may not exist.  The block itself
  # is built from the environment variables so the name can be escaped.
  (( $+functions[python-info] )) && python-info
  _prompt_bryndin_venv=$(prompt_bryndin_prepare_virtualenv)

  # Keep the exit-status text in a variable instead of relying on %? at draw
  # time. ZLE redraws can otherwise see the status of a prompt hook rather
  # than the user's command.
  if [[ $_prompt_bryndin_conf[exit-status] == yes ]]; then
    if (( _prompt_bryndin_last_status != 0 )); then
      local code=''
      [[ $_prompt_bryndin_conf[show-return-code] == yes ]] && \
        code="${_prompt_bryndin_last_status} "
      _prompt_bryndin_status_text="${_prompt_bryndin_fg[error-color]}✘ ${code}${_prompt_bryndin_fg[reset]}"
    else
      _prompt_bryndin_status_text=''
    fi
  else
    _prompt_bryndin_status_text=''
  fi

  # Prepare header line
  prompt_bryndin_prepare_header

  # fallback to compressed PWD if blocks aren't fitting
  (( _prompt_bryndin_overflow > 0 )) && _prompt_bryndin_cur_dir="$(prompt_bryndin_prepare_compressed_pwd)" && prompt_bryndin_prepare_header

  # If it still does not fit, clip the directory by the remaining deficit so
  # the line never wraps.  prompt-pwd's '%%' escaping is undone for measuring
  # and re-applied by prompt_bryndin_pwd_text afterwards.
  if (( _prompt_bryndin_overflow > 0 )); then
    local plain=$(prompt_bryndin_pwd_text 0)
    local keep=$(( ${(m)#${plain//\%\%/\%}} - _prompt_bryndin_overflow ))
    (( keep < 1 )) && keep=1
    _prompt_bryndin_cur_dir="$(prompt_bryndin_prepare_compressed_pwd $keep)"
    prompt_bryndin_prepare_header
  fi

  # Store the finished header as prompt text.  It is rendered as part of
  # PROMPT rather than printed by precmd, so it survives clear-screen,
  # reset-prompt, vi keymap switches and terminal resizes.
  prompt_bryndin_reflow
  return ${_prompt_bryndin_last_status:-0}
}

#
# Reflow the header after a terminal resize.  This is installed as TRAPWINCH:
# ZLE does not run line-pre-redraw on SIGWINCH, so the header would otherwise
# keep its old width until the next command.
#
function prompt_bryndin_resize {
  emulate -L zsh
  [[ -n $_prompt_bryndin_header ]] || return 0
  prompt_bryndin_reflow
  [[ -o zle ]] && zle reset-prompt
  return 0
}

function prompt_bryndin_line_pre_redraw {
  emulate -L zsh
  # Keep the per-keystroke path cheap: reflow is handled by the resize trap.
  [[ -n ${BUFFER:-} && -n $_prompt_bryndin_status_text ]] || return 0

  # Clearing the variable only updates the state: zsh expands PROMPT/RPROMPT
  # when zle starts or when reset-prompt runs, not on every keystroke.  Leave
  # the status alone while menu completion is active, where resetting the
  # prompt would disturb the menu; the next normal redraw will clear it.
  [[ ${KEYMAP:-} == menuselect ]] && return 0

  _prompt_bryndin_status_text=''
  zle reset-prompt
  return 0
}

#
# Preview used by `prompt -p bryndin'.
#
function prompt_bryndin_preview {
  local +h PROMPT='' RPROMPT='' SPROMPT=''
  (( $+functions[editor-info] )) && editor-info 2>/dev/null
  (( $+functions[prompt_preview_theme] )) && prompt_preview_theme 'bryndin' "$@"
}

#
# Release everything the theme owns when another theme is selected.  promptinit
# removes prompt_*_precmd/preexec hooks by name, but not our zle hook, async
# worker, globals or zstyles.
#
function prompt_bryndin_teardown {
  emulate -L zsh
  # Filter the hook arrays directly so cleanup also works when add-zsh-hook is
  # not available in the current scope.
  precmd_functions=(${precmd_functions:#prompt_bryndin_*})
  preexec_functions=(${preexec_functions:#prompt_bryndin_*})
  (( $+functions[add-zle-hook-widget] )) && \
    add-zle-hook-widget -d line-pre-redraw prompt_bryndin_line_pre_redraw

  # Restore the SIGWINCH trap only if it is still ours.
  if (( _prompt_bryndin_trapwinch_installed )) && \
     [[ $functions[TRAPWINCH] == *prompt_bryndin_resize* ]]; then
    if (( _prompt_bryndin_had_trapwinch )); then
      functions[TRAPWINCH]=$_prompt_bryndin_saved_trapwinch
    else
      unfunction TRAPWINCH 2>/dev/null
    fi
  fi

  (( $+functions[async_stop_worker] )) && async_stop_worker prompt_bryndin 2>/dev/null

  unset _prompt_bryndin_conf _prompt_bryndin_fg _prompt_bryndin_blocks \
    _prompt_bryndin_block_text _prompt_bryndin_block_expanded \
    _prompt_bryndin_left _prompt_bryndin_right _prompt_bryndin_left_expanded \
    _prompt_bryndin_right_expanded _prompt_bryndin_header _prompt_bryndin_cur_dir \
    _prompt_bryndin_filler_width _prompt_bryndin_overflow _prompt_bryndin_monochrome \
    _prompt_bryndin_cmd_start _prompt_bryndin_duration_text \
    _prompt_bryndin_git _prompt_bryndin_venv _prompt_bryndin_async \
    _prompt_bryndin_last_status _prompt_bryndin_status_text \
    _prompt_bryndin_color_pat _prompt_bryndin_trapwinch_installed \
    _prompt_bryndin_had_trapwinch _prompt_bryndin_saved_trapwinch
  zstyle -d ':prezto:module:prompt' managed
}

function prompt_bryndin_setup {
  setopt LOCAL_OPTIONS
  unsetopt XTRACE KSH_ARRAYS
  # A caller using `emulate -L' sets LOCAL_TRAPS; without this the resize trap
  # would be restored when setup returns.
  unsetopt LOCAL_TRAPS
  prompt_opts=(cr percent sp subst)

  # Build the colour map (this also re-reads zstyles, so `prompt bryndin' and
  # previews pick up changes made after the theme was first sourced).
  prompt_bryndin_build_colors

  # Load required functions.
  autoload -Uz add-zsh-hook add-zle-hook-widget
  prompt_bryndin_has_prompt_pwd && autoload -Uz prompt-pwd

  # Add hook for calling git-info before each command.
  precmd_functions=(prompt_bryndin_precmd_status ${precmd_functions:#prompt_bryndin_precmd_status})
  add-zsh-hook precmd prompt_bryndin_precmd
  add-zsh-hook preexec prompt_bryndin_preexec
  add-zle-hook-widget line-pre-redraw prompt_bryndin_line_pre_redraw

  # Reflow on SIGWINCH.  Save any existing trap so switching themes restores
  # it instead of silently replacing the user's handler.
  if (( ! _prompt_bryndin_trapwinch_installed )); then
    if (( $+functions[TRAPWINCH] )); then
      _prompt_bryndin_had_trapwinch=1
      _prompt_bryndin_saved_trapwinch=$functions[TRAPWINCH]
    else
      _prompt_bryndin_had_trapwinch=0
      _prompt_bryndin_saved_trapwinch=''
    fi
    TRAPWINCH() { prompt_bryndin_resize }
    _prompt_bryndin_trapwinch_installed=1
  fi

  # Required for the editor module to populate editor_info (see
  # modules/prompt/README.md): without it the second prompt line is empty.
  zstyle ':prezto:module:prompt' managed 'yes'
  (( $+functions[prompt_cleanup] )) && \
    prompt_cleanup 'prompt_bryndin_teardown' 2>/dev/null

  # Set editor-info parameters.  These are consumed by editor-info at draw
  # time, so monochrome mode needs its own colourless variants.
  if (( _prompt_bryndin_monochrome )); then
    zstyle ':prezto:module:editor:info:completing' format '...'
    zstyle ':prezto:module:editor:info:keymap:primary' format '❯❯❯'
    zstyle ':prezto:module:editor:info:keymap:primary:overwrite' format '♺'
    zstyle ':prezto:module:editor:info:keymap:alternate' format '❮❮❮'
  else
    zstyle ':prezto:module:editor:info:completing' format '%B%F{red}...%f%b'
    zstyle ':prezto:module:editor:info:keymap:primary' format '%B%F{red}❯%F{yellow}❯%F{green}❯%f%b'
    zstyle ':prezto:module:editor:info:keymap:primary:overwrite' format '%F{red}♺%f'
    zstyle ':prezto:module:editor:info:keymap:alternate' format '%B%F{green}❮%F{yellow}❮%F{red}❮%f%b'
  fi

  # Set git-info parameters.
  zstyle ':prezto:module:git:info' verbose 'yes'
  zstyle ':prezto:module:git:info:action' format ':%%B%F{yellow}%s%f%%b'
  zstyle ':prezto:module:git:info:added' format ' %%B%F{green}✚%f%%b'
  zstyle ':prezto:module:git:info:ahead' format ' %%B%F{yellow}⬆%f%%b'
  zstyle ':prezto:module:git:info:behind' format ' %%B%F{yellow}⬇%f%%b'
  zstyle ':prezto:module:git:info:branch' format ':%F{green}%b%f'
  zstyle ':prezto:module:git:info:commit' format ':%F{green}%.7c%f'
  zstyle ':prezto:module:git:info:deleted' format ' %%B%F{red}✖%f%%b'
  zstyle ':prezto:module:git:info:modified' format ' %%B%F{blue}✱%f%%b'
  zstyle ':prezto:module:git:info:position' format ':%F{red}%p%f'
  zstyle ':prezto:module:git:info:renamed' format ' %%B%F{magenta}➜%f%%b'
  zstyle ':prezto:module:git:info:stashed' format ' %%B%F{cyan}✭%f%%b'
  zstyle ':prezto:module:git:info:unmerged' format ' %%B%F{yellow}═%f%%b'
  zstyle ':prezto:module:git:info:untracked' format ' %%B%F{white}◼%f%%b'
  # Keep $(coalesce ...) quoted so it is evaluated by ${(e)git_info[prompt]}
  # *after* git-info's zformat has substituted %b/%p/%c.  Using double quotes
  # here would run it at setup time with three literal, non-empty arguments.
  local main_fg=${_prompt_bryndin_fg[main-color]}
  local reset_fg=${_prompt_bryndin_fg[reset]}
  zstyle ':prezto:module:git:info:keys' format \
    'prompt' "${main_fg}─(${_prompt_bryndin_fg[git-color]}git${reset_fg}"'$(coalesce "%b" "%p" "%c")'"%s%A%B%S%a%d%m%r%U%u${main_fg})${reset_fg}"

  # Keep virtualenv from prefixing the prompt with `(.venv) '.  In zsh, $PS1
  # and $PROMPT are the same parameter, so a sourced activate script would
  # edit this very theme's output.  Prezto's python module exports
  # VIRTUAL_ENV_DISABLE_PROMPT only when virtualenvwrapper is initialised,
  # which leaves plain `venv' environments defenceless, so do it here --
  # matching pure, which swaps an empty/unset value for the same sentinel
  # ('20') and so may other themes.  A deliberately different value (pure's
  # "user took control" signal) must be preserved.
  export VIRTUAL_ENV_DISABLE_PROMPT="${VIRTUAL_ENV_DISABLE_PROMPT:-20}"

  # Set python-info (virtualenv) parameters.  Kept for compatibility with other
  # themes; this theme renders the block from the env vars itself so it can
  # escape the name (see prompt_bryndin_prepare_virtualenv).
  zstyle ':prezto:module:python:info:virtualenv' format \
    "${main_fg}─<${_prompt_bryndin_fg[virtualenv-color]}%v${main_fg}>${reset_fg}"

  ### Header blocks
  local time="$_prompt_bryndin_conf[time-format]"
  local time_block="${main_fg}─(${_prompt_bryndin_fg[time-color]}${time}${main_fg})${reset_fg}"

  local host=''
  prompt_bryndin_is_remote && host="${_prompt_bryndin_fg[host-color]}@%m${reset_fg}"
  # Keep the host outside the root/non-root branch.  It used to live in the
  # non-root branch only, so a remote root session lost the hostname.
  local host_block="${main_fg}─(${reset_fg}%(!.${_prompt_bryndin_fg[error-color]}.${_prompt_bryndin_fg[host-color]})%n${reset_fg}${host}${main_fg})${reset_fg}"

  local git_block='${_prompt_bryndin_git}'

  local virtualenv_block='${_prompt_bryndin_venv}'

  local dir_block="${main_fg}[${_prompt_bryndin_fg[dir-color]}"'${_prompt_bryndin_cur_dir}'"${main_fg}]─${reset_fg}"

  # Define prompts.  Blocks are selected (and ordered) by the `blocks` zstyle.
  # Keep the individual templates as well, so reflow can drop whole blocks on
  # a terminal too narrow to show them all.
  _prompt_bryndin_block_text=()
  local block
  for block in $_prompt_bryndin_blocks; do
    case $block in
      time)       _prompt_bryndin_block_text[time]=$time_block ;;
      host)       _prompt_bryndin_block_text[host]=$host_block ;;
      virtualenv) _prompt_bryndin_block_text[virtualenv]=$virtualenv_block ;;
      git)        _prompt_bryndin_block_text[git]=$git_block ;;
    esac
  done

  _prompt_bryndin_left=''
  for block in $_prompt_bryndin_blocks; do
    _prompt_bryndin_left+=$_prompt_bryndin_block_text[$block]
  done
  _prompt_bryndin_right="${dir_block}"
  if [[ $_prompt_bryndin_conf[keymap-indicator] == yes ]]; then
    # The ZLE keymap indicator (❯❯❯ / ❮❮❮) is opt-in: many people prefer a
    # bare input line.  It requires the `managed' zstyle above to be populated.
    PROMPT="%(!. %B${_prompt_bryndin_fg[error-color]}#${reset_fg}%b.)"'${editor_info[keymap]}'
  else
    # Keep a basic prompt character when the keymap indicator is disabled.
    # Without it the non-root branch of %(!...) is empty, leaving a bare line.
    PROMPT="%(!. %B${_prompt_bryndin_fg[error-color]}#${reset_fg}%b.%B${_prompt_bryndin_fg[main-color]}❯${reset_fg}%b)"
  fi

  # Prepend the header.  Keeping it inside PROMPT (instead of printing it from
  # precmd) means zle redraws reproduce it.  `single-line' drops it entirely.
  if [[ $_prompt_bryndin_conf[single-line] != yes ]]; then
    local newline="${prompt_newline:-$'\n'}"
    PROMPT='${_prompt_bryndin_header}'"${newline}"$PROMPT
  fi
  if (( _prompt_bryndin_monochrome )); then
    SPROMPT='zsh: correct %R to %r [nyae]? '
  else
    SPROMPT='zsh: correct %F{red}%R%f to %F{green}%r%f [nyae]? '
  fi

  # Last command status on the right of the input line.  The numeric code is
  # opt-in through the framework-wide show-return-val style. The value is
  # computed in precmd so ZLE redraws do not pick up a helper's status.
  RPROMPT=''
  [[ $_prompt_bryndin_conf[exit-status] == yes ]] && \
    RPROMPT='${_prompt_bryndin_status_text}'

  # Optional context indicators.  All are prompt strings: %-escapes and ${...}
  # are evaluated by zsh at draw time, not at setup time.
  [[ $_prompt_bryndin_conf[jobs] == yes ]] && \
    RPROMPT+="%(1j.${main_fg}[%j&]${reset_fg} .)"
  [[ $_prompt_bryndin_conf[history] == yes ]] && \
    RPROMPT+="${main_fg}!%!${reset_fg} "
  [[ $_prompt_bryndin_conf[duration] == yes ]] && \
    RPROMPT+='${_prompt_bryndin_duration_text}'
  [[ $_prompt_bryndin_conf[vim] == yes ]] && \
    RPROMPT+='${VIM:+" %BV%f%b"}'
  [[ $_prompt_bryndin_conf[overwrite] == yes ]] && \
    PROMPT+='${editor_info[overwrite]}'

  # Optional async git status.  Start the worker last: zpty workers inherit
  # the parent's zstyle database at fork time, so the git-info formats must be
  # configured before this point or the worker renders an empty git block.
  _prompt_bryndin_async=0
  if [[ $_prompt_bryndin_conf[async] == yes ]]; then
    local dir async_file=''
    for dir in $fpath; do
      [[ -r $dir/async ]] && { async_file=$dir/async; break }
    done
    if [[ -n $async_file ]]; then
      autoload -Uz async && async
      if (( $+functions[async_start_worker] )); then
        if async_start_worker prompt_bryndin -n -u; then
          async_register_callback prompt_bryndin prompt_bryndin_async_callback
          _prompt_bryndin_async=1
        fi
      fi
    fi
  fi
}

prompt_bryndin_setup "$@"
# vim: ft=zsh
