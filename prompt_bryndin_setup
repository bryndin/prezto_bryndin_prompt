# Custom two-line Prezto prompt
#
# Authors:
#   Dmitry Bryndin <bryndin@gmail.com>

# Declare all theme-owned globals in one place so re-entering setup after
# teardown works cleanly even under `setopt WARN_CREATE_GLOBAL`.
function prompt_bryndin_init_state {
  typeset -gA _prompt_bryndin_conf _prompt_bryndin_fg
  typeset -gA _prompt_bryndin_block_text _prompt_bryndin_block_expanded
  typeset -ga _prompt_bryndin_blocks _prompt_bryndin_drop_order
  typeset -g  _prompt_bryndin_monochrome=0
  typeset -g  _prompt_bryndin_cmd_start=''
  typeset -g  _prompt_bryndin_duration_text=''
  typeset -g  _prompt_bryndin_last_status=0
  typeset -g  _prompt_bryndin_status_text=''
  typeset -g  _prompt_bryndin_status_dismissed=0
  typeset -g  _prompt_bryndin_git=''
  typeset -g  _prompt_bryndin_venv=''
  typeset -g  _prompt_bryndin_time=''
  typeset -g  _prompt_bryndin_async=0
  typeset -g  _prompt_bryndin_has_git_block=0
  typeset -g  _prompt_bryndin_has_venv_block=0
  typeset -g  _prompt_bryndin_has_time_block=0
  typeset -g  _prompt_bryndin_left=''
  typeset -g  _prompt_bryndin_right=''
  typeset -g  _prompt_bryndin_left_expanded=''
  typeset -g  _prompt_bryndin_right_expanded=''
  typeset -g  _prompt_bryndin_header=''
  typeset -g  _prompt_bryndin_cur_dir=''
  typeset -g  _prompt_bryndin_cached_prompt_pwd=''
  typeset -g  _prompt_bryndin_has_cached_pwd=0
  typeset -g  _prompt_bryndin_filler_width=0
  typeset -g  _prompt_bryndin_overflow=0
  typeset -g  _prompt_bryndin_last_pwd=''
  typeset -g  _prompt_bryndin_git_root=''
  typeset -g  _prompt_bryndin_installed=${_prompt_bryndin_installed:-0}
  typeset -g  _prompt_bryndin_trapwinch_installed=${_prompt_bryndin_trapwinch_installed:-0}
  typeset -g  _prompt_bryndin_had_trapwinch=${_prompt_bryndin_had_trapwinch:-0}
  typeset -g  _prompt_bryndin_saved_trapwinch=${_prompt_bryndin_saved_trapwinch:-}
  typeset -g  _prompt_bryndin_had_managed=${_prompt_bryndin_had_managed:-0}
  typeset -g  _prompt_bryndin_saved_managed=${_prompt_bryndin_saved_managed:-}
}

prompt_bryndin_init_state

# Populated by git-info, python-info and editor-info when loaded.
typeset -gA git_info python_info editor_info

(( ${+functions[pmodload]} )) && pmodload 'helper'

# Load zstyles under ':prezto:module:prompt:bryndin'.
# Uses `main-color` rather than `color` so ':prezto:*:* color' cannot collide.
function prompt_bryndin_load_config {
  emulate -L zsh
  prompt_bryndin_init_state

  _prompt_bryndin_conf=(
    main-color        'cyan'
    time-color        '27'
    host-color        '27'
    virtualenv-color  'yellow'
    dir-color         '33'
    git-color         'blue'
    error-color       'red'
    separator         '─'
    separator-color   ''
    time-format       '%T'
    user              'always'
    host              'auto'
    compressed-pwd    'prompt-pwd'
    colors            'auto'
    max-block-width   '0'
    margin            '0'
    async             'no'
    exit-status       'yes'
    jobs              'yes'
    history           'no'
    duration          'no'
    duration-min      '2'
    vim               'yes'
    overwrite         'yes'
    keymap-indicator  'no'
    single-line       'no'
    show-return-code  'no'
  )

  local key value have_show_return=0 have_compressed_pwd=0
  for key in ${(k)_prompt_bryndin_conf}; do
    value=''
    if zstyle -s ':prezto:module:prompt:bryndin' "$key" value; then
      _prompt_bryndin_conf[$key]=$value
      [[ $key == show-return-code ]] && have_show_return=1
      [[ $key == compressed-pwd ]] && have_compressed_pwd=1
    fi
  done

  # Support historical `pwd` alias when `compressed-pwd` is not explicitly set.
  if (( ! have_compressed_pwd )) && zstyle -s ':prezto:module:prompt:bryndin' pwd value; then
    _prompt_bryndin_conf[compressed-pwd]=$value
  fi

  local -a bool_keys=(
    async exit-status jobs history duration vim overwrite
    keymap-indicator single-line show-return-code
  )
  for key in $bool_keys; do
    case ${_prompt_bryndin_conf[$key]} in
      true|on|1)   _prompt_bryndin_conf[$key]='yes' ;;
      false|off|0) _prompt_bryndin_conf[$key]='no' ;;
    esac
  done

  _prompt_bryndin_blocks=()
  zstyle -a ':prezto:module:prompt:bryndin' blocks _prompt_bryndin_blocks \
    || _prompt_bryndin_blocks=(time host virtualenv git)

  _prompt_bryndin_drop_order=()
  zstyle -a ':prezto:module:prompt:bryndin' drop-order _prompt_bryndin_drop_order \
    || _prompt_bryndin_drop_order=(time host virtualenv git)

  _prompt_bryndin_has_git_block=$(( ${_prompt_bryndin_blocks[(I)git]} > 0 ))
  _prompt_bryndin_has_venv_block=$(( ${_prompt_bryndin_blocks[(I)virtualenv]} > 0 ))
  _prompt_bryndin_has_time_block=$(( ${_prompt_bryndin_blocks[(I)time]} > 0 ))

  if (( ! have_show_return )); then
    if zstyle -t ':prezto:module:prompt' show-return-val; then
      _prompt_bryndin_conf[show-return-code]='yes'
    else
      _prompt_bryndin_conf[show-return-code]='no'
    fi
  fi
}

# Strip %f/%k/%F{...}/%K{...} in-process while preserving literal `%%`.
function prompt_bryndin_strip_colors_reply {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local s=$1 sentinel=$'\001bryndin\002' color_pat='%([fk]|([FK]){*})'
  s=${s//\%\%/$sentinel}
  s=${(S)s//$~color_pat/}
  REPLY=${s//$sentinel/%%}
}

# Resolve a colour spec into a %F{...} escape, downgrading 256-colour indices
# on 16/8-colour terminals when `colors` is `auto` or `16`.
function prompt_bryndin_color_escape_reply {
  emulate -L zsh
  local spec=$1
  if (( _prompt_bryndin_monochrome )); then
    REPLY=''
    return 0
  fi

  local mode=$_prompt_bryndin_conf[colors]
  local ncolors=${terminfo[colors]:-0}
  local downgrade=0
  if [[ $mode == 16 ]]; then
    downgrade=1
  elif [[ $mode == auto && $COLORTERM != (truecolor|24bit) ]] && (( ncolors < 256 )); then
    downgrade=1
  fi

  if [[ $spec == <-> ]] && (( downgrade )); then
    if (( spec >= 8 && spec < 16 && ncolors > 0 && ncolors <= 8 )); then
      spec=$(( spec - 8 ))
    elif (( spec >= 16 && spec < 232 )); then
      local idx=$(( spec - 16 ))
      local r=$(( idx / 36 )) g=$(( (idx / 6) % 6 )) b=$(( idx % 6 ))
      spec=$(( (r >= 2) + 2 * (g >= 2) + 4 * (b >= 2) ))
    elif (( spec >= 232 && spec < 256 )); then
      spec=$(( spec < 244 ? (ncolors > 0 && ncolors <= 8 ? 0 : 8) : 7 ))
    elif (( spec >= 256 )); then
      spec='default'
    fi
  fi
  REPLY="%F{$spec}"
}

function prompt_bryndin_build_colors {
  emulate -L zsh
  prompt_bryndin_load_config
  local mode=$_prompt_bryndin_conf[colors]
  _prompt_bryndin_monochrome=0
  [[ $mode == none || -n $NO_COLOR || $TERM == dumb ]] && _prompt_bryndin_monochrome=1

  _prompt_bryndin_fg=()
  local key
  for key in main-color time-color host-color virtualenv-color dir-color git-color error-color; do
    prompt_bryndin_color_escape_reply "$_prompt_bryndin_conf[$key]"
    _prompt_bryndin_fg[$key]=$REPLY
  done
  prompt_bryndin_color_escape_reply \
    "${_prompt_bryndin_conf[separator-color]:-$_prompt_bryndin_conf[main-color]}"
  _prompt_bryndin_fg[separator-color]=$REPLY
  if (( _prompt_bryndin_monochrome )); then
    _prompt_bryndin_fg[reset]=''
  else
    _prompt_bryndin_fg[reset]='%f'
  fi
}

# Escape literal `%` for safe insertion via parameter expansion in PROMPT.
function prompt_bryndin_escape_reply {
  emulate -L zsh
  REPLY=${1//\%/\%\%}
}

# Clip plain text to `max` display columns, appending `…`.
function prompt_bryndin_clip_reply {
  emulate -L zsh
  local text=$1 max=$2
  if (( max <= 0 || ${(m)#text} <= max )); then
    REPLY=$text
    return 0
  fi

  local -a chars=( ${(s::)text} )
  local out='' c width=0 cw
  for c in $chars; do
    cw=${(m)#c}
    (( width + cw > max - 1 )) && break
    out+=$c
    (( width += cw ))
  done
  REPLY="${out}…"
}

function prompt_bryndin_clip_max_reply {
  emulate -L zsh
  local max=${_prompt_bryndin_conf[max-block-width]:-0}
  if [[ $max == <-> ]] && (( max > 0 )); then
    prompt_bryndin_clip_reply "$1" "$max"
  else
    REPLY=$1
  fi
}

function prompt_bryndin_virtualenv_reply {
  emulate -L zsh
  local name=${VIRTUAL_ENV:t}
  [[ -z $name ]] && name=$CONDA_DEFAULT_ENV
  if [[ -z $name ]]; then
    REPLY=''
    return 0
  fi
  prompt_bryndin_clip_max_reply "$name"
  prompt_bryndin_escape_reply "$REPLY"
  REPLY="${_prompt_bryndin_fg[main-color]}─<${_prompt_bryndin_fg[virtualenv-color]}${REPLY}${_prompt_bryndin_fg[main-color]}>${_prompt_bryndin_fg[reset]}"
}

# Detect remote sessions or account switches without forking external binaries.
function prompt_bryndin_is_remote {
  emulate -L zsh
  case $_prompt_bryndin_conf[host] in
    yes|always|true|on|1) return 0 ;;
    no|never|false|off|0) return 1 ;;
  esac
  [[ -n $SSH_TTY || -n $SSH_CLIENT || -n $SSH_CONNECTION ]] && return 0
  [[ -n $SUDO_USER && $SUDO_USER != $USER ]] && return 0
  [[ -n $LOGNAME && $LOGNAME != $USER ]] && return 0
  return 1
}

function prompt_bryndin_has_prompt_pwd {
  emulate -L zsh
  local dir
  for dir in $fpath; do
    [[ -r $dir/prompt-pwd ]] && return 0
  done
  return 1
}

function prompt_bryndin_tilde_pwd_reply {
  emulate -L zsh
  local home=${HOME%/}
  if [[ -z $home ]]; then
    REPLY=$PWD
  elif [[ $PWD == $home ]]; then
    REPLY='~'
  elif [[ $PWD == $home/* ]]; then
    REPLY="~${PWD#$home}"
  else
    REPLY=$PWD
  fi
}

function prompt_bryndin_full_pwd_reply {
  emulate -L zsh
  local max=${_prompt_bryndin_conf[max-block-width]:-0}
  [[ $max == <-> ]] || max=0
  local text='%~'
  if (( max > 0 )); then
    local expanded=${(%):-%~}
    if (( ${(m)#expanded} > max )); then
      prompt_bryndin_clip_reply "$expanded" "$max"
      text=${REPLY//\%/%%}
    fi
  fi
  if [[ -w $PWD ]]; then
    REPLY=$text
  else
    REPLY="${_prompt_bryndin_fg[error-color]}${text}${_prompt_bryndin_fg[reset]}"
  fi
}

# Compute the unclipped plain-text compressed path, caching `prompt-pwd` across
# a single layout pass so resize/overflow never forks `prompt-pwd` repeatedly.
function prompt_bryndin_pwd_raw_reply {
  emulate -L zsh
  setopt EXTENDED_GLOB
  case $_prompt_bryndin_conf[compressed-pwd] in
    full)
      REPLY=$PWD
      ;;
    tilde)
      prompt_bryndin_tilde_pwd_reply
      ;;
    *)
      if (( _prompt_bryndin_has_cached_pwd )); then
        REPLY=$_prompt_bryndin_cached_prompt_pwd
      elif prompt_bryndin_has_prompt_pwd; then
        local raw=$(prompt-pwd)
        REPLY=${raw//\%\%/\%}
        _prompt_bryndin_cached_prompt_pwd=$REPLY
        _prompt_bryndin_has_cached_pwd=1
      else
        prompt_bryndin_tilde_pwd_reply
        local pwd=$REPLY
        if [[ $pwd == (#m)[/~] ]]; then
          REPLY=$MATCH
        else
          REPLY="${${${(@j:/:M)${(@s:/:)pwd}##.#?}:h}%/}/${pwd:t}"
        fi
        _prompt_bryndin_cached_prompt_pwd=$REPLY
        _prompt_bryndin_has_cached_pwd=1
      fi
      ;;
  esac
}

function prompt_bryndin_pwd_text_reply {
  emulate -L zsh
  local max=${1:-$_prompt_bryndin_conf[max-block-width]}
  [[ $max == <-> ]] || max=0
  prompt_bryndin_pwd_raw_reply
  if (( max > 0 )); then
    prompt_bryndin_clip_reply "$REPLY" "$max"
  fi
  REPLY=${REPLY//\%/%%}
}

function prompt_bryndin_compressed_pwd_reply {
  emulate -L zsh
  prompt_bryndin_pwd_text_reply "$1"
  if [[ ! -w $PWD ]]; then
    REPLY="${_prompt_bryndin_fg[error-color]}${REPLY}${_prompt_bryndin_fg[reset]}"
  fi
}

# Expand a prompt fragment without PROMPT_SUBST and strip zero-width escapes
# (%{...%}, CSI, non-CSI resets, control chars) to get its plain text.
function prompt_bryndin_expand_plain_reply {
  emulate -L zsh
  setopt EXTENDED_GLOB
  unsetopt PROMPT_SUBST
  local text=$1
  local sentinel=$'\001bryndin\002'
  local literal_escape='%{*%}'
  local csi=$'\e''\[[0-9;:?]#[a-zA-Z]'
  local noncsi=$'\e''([()][0-9A-Za-z]|[=>78])'
  local ctrl=$'[\001-\010\013-\037\177]'
  text=${text//\%\%/$sentinel}
  text=${(S)text//$~literal_escape/}
  text=${(%%)text}
  text=${text//$~csi/}
  text=${text//$~noncsi/}
  text=${text//$sentinel/\%}
  REPLY=${text//$~ctrl/}
}

# Measure visible display columns of a prompt fragment safely.
function prompt_bryndin_visible_width {
  emulate -L zsh
  prompt_bryndin_expand_plain_reply "$1"
  REPLY=${(m)#REPLY}
}

function prompt_bryndin_measure {
  emulate -L zsh
  local left=$1 right=$2 left_width right_width
  prompt_bryndin_visible_width "$left"
  left_width=$REPLY
  prompt_bryndin_visible_width "$right"
  right_width=$REPLY

  local margin=${_prompt_bryndin_conf[margin]:-0}
  [[ $margin == <-> ]] || margin=0
  local columns=${COLUMNS:-80}
  (( columns > 0 )) || columns=80
  local width=$(( columns - left_width - right_width - margin ))
  _prompt_bryndin_filler_width=$(( width > 0 ? width : 0 ))
  _prompt_bryndin_overflow=$(( width < 0 ? -width : 0 ))
}

function prompt_bryndin_prepare_header {
  emulate -L zsh
  if (( _prompt_bryndin_has_time_block )); then
    local max=${_prompt_bryndin_conf[max-block-width]:-0}
    if [[ $max == <-> ]] && (( max > 0 )); then
      prompt_bryndin_expand_plain_reply "$_prompt_bryndin_conf[time-format]"
      prompt_bryndin_clip_reply "$REPLY" "$max"
      _prompt_bryndin_time=${REPLY//\%/%%}
    fi
  fi

  local block expanded left=''
  _prompt_bryndin_block_expanded=()
  for block in $_prompt_bryndin_blocks; do
    expanded=${(e)_prompt_bryndin_block_text[$block]}
    _prompt_bryndin_block_expanded[$block]=$expanded
    left+=$expanded
  done

  local right=${(e)_prompt_bryndin_right}
  _prompt_bryndin_left_expanded=$left
  _prompt_bryndin_right_expanded=$right
  prompt_bryndin_measure "$left" "$right"
}

# Drop active non-empty left blocks in `_prompt_bryndin_drop_order` until
# `right` ($1) fits or no non-empty blocks remain.  Sets `REPLY` to the new
# expanded left string.
function prompt_bryndin_drop_blocks_reply {
  emulate -L zsh
  local right=$1
  local -a active=($_prompt_bryndin_blocks)
  local left='' block drop idx
  for block in $active; do left+=$_prompt_bryndin_block_expanded[$block]; done
  prompt_bryndin_measure "$left" "$right"

  while (( _prompt_bryndin_overflow > 0 && $#active > 0 )); do
    idx=0
    for drop in $_prompt_bryndin_drop_order; do
      idx=${active[(I)$drop]}
      (( idx > 0 )) && [[ -n ${_prompt_bryndin_block_expanded[$drop]} ]] && break
      idx=0
    done
    if (( idx == 0 )); then
      for (( idx = $#active; idx >= 1; idx-- )); do
        [[ -n ${_prompt_bryndin_block_expanded[${active[$idx]}]} ]] && break
      done
    fi
    (( idx == 0 )) && break
    active[$idx]=()
    left=''
    for block in $active; do left+=$_prompt_bryndin_block_expanded[$block]; done
    prompt_bryndin_measure "$left" "$right"
  done
  REPLY=$left
}

# Fit the directory and left-hand blocks to `$COLUMNS`:
#   1. Full `%~` path (with `max-block-width` if set)
#   2. `compressed-pwd`
#   3. Clip `compressed-pwd` down to a readable 15-column floor
#   4. Drop lowest-priority blocks (`drop-order`: time, host, virtualenv, git)
#   5. Re-fit `compressed-pwd` into the space left alongside remaining blocks
function prompt_bryndin_prepare_pwd {
  emulate -L zsh
  setopt EXTENDED_GLOB
  _prompt_bryndin_has_cached_pwd=0
  _prompt_bryndin_cached_prompt_pwd=''
  {
    prompt_bryndin_full_pwd_reply
    _prompt_bryndin_cur_dir=$REPLY
    prompt_bryndin_prepare_header
    (( _prompt_bryndin_overflow == 0 )) && return 0

    prompt_bryndin_compressed_pwd_reply
    _prompt_bryndin_cur_dir=$REPLY
    prompt_bryndin_prepare_header
    (( _prompt_bryndin_overflow == 0 )) && return 0

    prompt_bryndin_pwd_text_reply
    local plain=${REPLY//\%\%/\%}
    local plain_width=${(m)#plain}
    local floor=$(( plain_width < 15 ? plain_width : 15 ))
    local keep=$(( plain_width - _prompt_bryndin_overflow ))
    if (( keep >= floor && keep >= 1 )); then
      prompt_bryndin_compressed_pwd_reply $keep
      _prompt_bryndin_cur_dir=$REPLY
      prompt_bryndin_prepare_header
      return 0
    fi

    if (( floor < plain_width && floor >= 1 )); then
      prompt_bryndin_compressed_pwd_reply $floor
      _prompt_bryndin_cur_dir=$REPLY
    fi
    local right=${(e)_prompt_bryndin_right}
    prompt_bryndin_drop_blocks_reply "$right"
    local left=$REPLY

    # Expand `compressed-pwd` back into any space freed by dropped blocks, or
    # clip below the floor when no droppable blocks remain.
    prompt_bryndin_compressed_pwd_reply
    _prompt_bryndin_cur_dir=$REPLY
    right=${(e)_prompt_bryndin_right}
    prompt_bryndin_measure "$left" "$right"
    if (( _prompt_bryndin_overflow > 0 )); then
      keep=$(( plain_width - _prompt_bryndin_overflow ))
      (( keep < 1 )) && keep=1
      prompt_bryndin_compressed_pwd_reply $keep
      _prompt_bryndin_cur_dir=$REPLY
      right=${(e)_prompt_bryndin_right}
      prompt_bryndin_measure "$left" "$right"
    fi
    _prompt_bryndin_left_expanded=$left
    _prompt_bryndin_right_expanded=$right
  } always {
    _prompt_bryndin_has_cached_pwd=0
    _prompt_bryndin_cached_prompt_pwd=''
  }
}

function prompt_bryndin_reflow {
  emulate -L zsh
  local left=$_prompt_bryndin_left_expanded
  local right=$_prompt_bryndin_right_expanded
  prompt_bryndin_measure "$left" "$right"

  if (( _prompt_bryndin_overflow > 0 )); then
    prompt_bryndin_drop_blocks_reply "$right"
    left=$REPLY
  fi

  local sep=${_prompt_bryndin_conf[separator]}
  local sep_escaped=${sep//\%/%%}
  local sep_width=${(m)#sep}
  (( sep_width < 1 )) && sep_width=1
  local count=$(( _prompt_bryndin_filler_width / sep_width ))
  local filler='' i
  for (( i = 0; i < count; i++ )); do filler+=$sep_escaped; done
  _prompt_bryndin_header="${left}${_prompt_bryndin_fg[separator-color]}${filler}${_prompt_bryndin_fg[reset]}${right}"
  if (( _prompt_bryndin_monochrome )); then
    prompt_bryndin_strip_colors_reply "$_prompt_bryndin_header"
    _prompt_bryndin_header=$REPLY
  fi
  return 0
}

function prompt_bryndin_git_reply {
  emulate -L zsh
  setopt EXTENDED_GLOB
  local branch=${git_info[bryndin-branch]}
  local position=${git_info[bryndin-position]}
  local commit=${git_info[bryndin-commit]}
  local target='' color=''
  if [[ -n $branch ]]; then
    target=$branch
    (( ! _prompt_bryndin_monochrome )) && color='%F{green}'
  elif [[ -n $position ]]; then
    target=$position
    (( ! _prompt_bryndin_monochrome )) && color='%F{red}'
  elif [[ -n $commit ]]; then
    target=$commit
    (( ! _prompt_bryndin_monochrome )) && color='%F{green}'
  fi

  if [[ -n $target ]]; then
    # Undo git-info's backslash escaping while keeping literal quotes intact.
    target=${target//(#m)\\?/${MATCH#\\}}
    prompt_bryndin_clip_max_reply "$target"
    target=${REPLY//\%/%%}
    target=":${color}${target}${_prompt_bryndin_fg[reset]}"
  fi
  REPLY="${git_info[bryndin-git-prefix]}${target}${git_info[bryndin-git-suffix]}"
}

function prompt_bryndin_async_git {
  emulate -L zsh
  REPLY=''
  if cd -q "$1" 2>/dev/null && (( ${+functions[git-info]} )) &&
     GIT_OPTIONAL_LOCKS=0 git-info; then
    prompt_bryndin_git_reply
  fi
  print -rn -- "$1"$'\001'"$REPLY"
}

function prompt_bryndin_async_callback {
  emulate -L zsh
  if [[ $1 == '[async]' ]]; then
    _prompt_bryndin_async=0
    (( ${+functions[async_stop_worker]} )) && async_stop_worker prompt_bryndin 2>/dev/null
    return 0
  fi

  [[ $1 == prompt_bryndin_async_git && $3 == *$'\001'* ]] || return 0
  local job_pwd=${3%%$'\001'*}
  local rendered=${3#*$'\001'}
  [[ $job_pwd == $PWD ]] || return 0
  [[ $rendered == $_prompt_bryndin_git ]] && return 0
  _prompt_bryndin_git=$rendered
  [[ $_prompt_bryndin_conf[single-line] == yes ]] && return 0
  prompt_bryndin_prepare_pwd
  prompt_bryndin_reflow
  zle && zle reset-prompt
}

function prompt_bryndin_format_duration_reply {
  emulate -L zsh
  local -i s=$1
  if (( s < 60 )); then
    REPLY="${s}s"
  elif (( s < 3600 )); then
    local -i m=$(( s / 60 )) rem=$(( s % 60 ))
    (( rem > 0 )) && REPLY="${m}m ${rem}s" || REPLY="${m}m"
  else
    local -i h=$(( s / 3600 )) m=$(( (s % 3600) / 60 ))
    (( m > 0 )) && REPLY="${h}h ${m}m" || REPLY="${h}h"
  fi
}

function prompt_bryndin_preexec {
  _prompt_bryndin_status_text=''
  _prompt_bryndin_status_dismissed=0
  _prompt_bryndin_cmd_start=${EPOCHREALTIME:-$SECONDS}
}

function prompt_bryndin_precmd_status {
  _prompt_bryndin_last_status=$?
}

# Check whether $PWD is inside the cached `_prompt_bryndin_git_root` worktree
# without entering `.git` or a nested repository/submodule.
function prompt_bryndin_in_cached_repo {
  emulate -L zsh
  local root=$_prompt_bryndin_git_root
  [[ -n $root && -e ${root%/}/.git ]] || return 1
  [[ $PWD == */.git || $PWD == */.git/* ]] && return 1
  [[ $PWD == $root || $PWD == ${root%/}/* ]] || return 1
  local d=$PWD
  while [[ $d != $root && -n $d && $d != / ]]; do
    [[ -e $d/.git ]] && return 1
    d=${d:h}
  done
  return 0
}

function prompt_bryndin_precmd {
  emulate -L zsh
  setopt EXTENDED_GLOB

  # Command duration.
  _prompt_bryndin_duration_text=''
  if [[ -n $_prompt_bryndin_cmd_start ]]; then
    local -F now=${EPOCHREALTIME:-$SECONDS} start=$_prompt_bryndin_cmd_start
    local -i elapsed=0
    (( now > start )) && (( elapsed = now - start ))
    _prompt_bryndin_cmd_start=''
    local min_sec=${_prompt_bryndin_conf[duration-min]:-2}
    [[ $min_sec == <-> ]] || min_sec=2
    (( min_sec < 1 )) && min_sec=1
    if (( elapsed >= min_sec )); then
      prompt_bryndin_format_duration_reply $elapsed
      _prompt_bryndin_duration_text=" ${REPLY}"
    fi
  fi

  # Last command exit status (suppressed if dismissed on keystroke without a new command).
  if [[ $_prompt_bryndin_conf[exit-status] == yes ]] &&
     (( ! _prompt_bryndin_status_dismissed && _prompt_bryndin_last_status != 0 )); then
    _prompt_bryndin_status_text="${_prompt_bryndin_fg[error-color]}✘"
    [[ $_prompt_bryndin_conf[show-return-code] == yes ]] && \
      _prompt_bryndin_status_text+=" ${_prompt_bryndin_last_status}"
    _prompt_bryndin_status_text+="${_prompt_bryndin_fg[reset]}"
  else
    _prompt_bryndin_status_text=''
  fi

  if [[ $_prompt_bryndin_conf[single-line] == yes ]]; then
    _prompt_bryndin_header=''
    return 0
  fi

  # Git block (skipped entirely when `git` is not in `blocks`).
  if (( _prompt_bryndin_has_git_block )); then
    if (( _prompt_bryndin_async )); then
      if [[ -z $_prompt_bryndin_last_pwd || $PWD != $_prompt_bryndin_last_pwd ]]; then
        local root=''
        if prompt_bryndin_in_cached_repo; then
          root=$_prompt_bryndin_git_root
        elif (( ${+commands[git]} )); then
          root=$(GIT_OPTIONAL_LOCKS=0 command git rev-parse --show-toplevel 2>/dev/null)
        fi
        if [[ -n $_prompt_bryndin_last_pwd && $root != $_prompt_bryndin_git_root ]]; then
          _prompt_bryndin_git=''
        fi
        _prompt_bryndin_git_root=$root
      fi
      if ! zpty -t prompt_bryndin &>/dev/null; then
        _prompt_bryndin_async=0
        (( ${+functions[async_stop_worker]} )) && async_stop_worker prompt_bryndin 2>/dev/null
      else
        (( ${+functions[async_flush_jobs]} )) && async_flush_jobs prompt_bryndin 2>/dev/null
        if ! async_job prompt_bryndin prompt_bryndin_async_git "$PWD"; then
          _prompt_bryndin_async=0
          (( ${+functions[async_stop_worker]} )) && async_stop_worker prompt_bryndin 2>/dev/null
        fi
      fi
    fi
    _prompt_bryndin_last_pwd=$PWD

    if (( ! _prompt_bryndin_async )); then
      if (( ${+functions[git-info]} )) && GIT_OPTIONAL_LOCKS=0 git-info; then
        prompt_bryndin_git_reply
        _prompt_bryndin_git=$REPLY
      else
        _prompt_bryndin_git=''
      fi
    fi
  else
    _prompt_bryndin_git=''
  fi

  # Virtualenv / Conda block (read directly from env vars without forking python-info).
  if (( _prompt_bryndin_has_venv_block )) &&
     [[ -n ${VIRTUAL_ENV:-} || -n ${CONDA_DEFAULT_ENV:-} ]]; then
    prompt_bryndin_virtualenv_reply
    _prompt_bryndin_venv=$REPLY
  else
    _prompt_bryndin_venv=''
  fi

  prompt_bryndin_prepare_pwd
  prompt_bryndin_reflow
  return 0
}

function prompt_bryndin_resize {
  emulate -L zsh
  if (( _prompt_bryndin_had_trapwinch && ${+functions[_prompt_bryndin_user_trapwinch]} )); then
    _prompt_bryndin_user_trapwinch
  fi
  [[ $_prompt_bryndin_conf[single-line] == yes || -z $_prompt_bryndin_header ]] && return 0
  prompt_bryndin_prepare_pwd
  prompt_bryndin_reflow
  zle && zle reset-prompt
  return 0
}

function prompt_bryndin_line_pre_redraw {
  emulate -L zsh
  [[ -n ${BUFFER:-} && -n $_prompt_bryndin_status_text ]] || return 0
  [[ ${CONTEXT:-start} == start ]] || return 0
  [[ ${KEYMAP:-} == menuselect || ${ZLE_STATE:-} == *isearch* ]] && return 0

  _prompt_bryndin_status_text=''
  _prompt_bryndin_status_dismissed=1
  zle reset-prompt
  return 0
}

# Run preview inside a real subshell so `prompt -p bryndin` never mutates the
# active theme's zstyles, hooks, globals or resize trap.
function prompt_bryndin_preview {
  (
    emulate -L zsh
    local +h PROMPT='' RPROMPT='' SPROMPT=''
    local -a prompt_opts
    local _prompt_bryndin_preview=1
    print -n 'bryndin theme'
    (( $# > 0 )) && print -n " with parameters \`$*'"
    print ':'
    prompt_bryndin_setup "$@"
    (( ${#prompt_opts} )) && \
      setopt noprompt{bang,cr,percent,sp,subst} "prompt${^prompt_opts[@]}"
    prompt_bryndin_precmd
    (( ${+functions[editor-info]} )) && editor-info 2>/dev/null
    [[ -o promptcr ]] && print -n $'\r'
    print -rP -- "${PROMPT}command arg1 arg2 ... argn"
  )
}

function prompt_bryndin_teardown {
  emulate -L zsh
  precmd_functions=(${precmd_functions:#prompt_bryndin_*})
  preexec_functions=(${preexec_functions:#prompt_bryndin_*})
  (( ${+functions[add-zle-hook-widget]} )) && \
    add-zle-hook-widget -d line-pre-redraw prompt_bryndin_line_pre_redraw

  if (( _prompt_bryndin_trapwinch_installed )); then
    if [[ $functions[TRAPWINCH] == *prompt_bryndin_resize* ]]; then
      if (( _prompt_bryndin_had_trapwinch )); then
        functions[TRAPWINCH]=$_prompt_bryndin_saved_trapwinch
      else
        unfunction TRAPWINCH 2>/dev/null
      fi
    fi
    unfunction _prompt_bryndin_user_trapwinch 2>/dev/null
  fi

  (( ${+functions[async_stop_worker]} )) && async_stop_worker prompt_bryndin 2>/dev/null

  if (( _prompt_bryndin_had_managed )); then
    zstyle ':prezto:module:prompt' managed "$_prompt_bryndin_saved_managed"
  else
    zstyle -d ':prezto:module:prompt' managed
  fi

  unset _prompt_bryndin_conf _prompt_bryndin_fg _prompt_bryndin_blocks \
    _prompt_bryndin_drop_order _prompt_bryndin_block_text \
    _prompt_bryndin_block_expanded _prompt_bryndin_left _prompt_bryndin_right \
    _prompt_bryndin_left_expanded _prompt_bryndin_right_expanded \
    _prompt_bryndin_header _prompt_bryndin_cur_dir \
    _prompt_bryndin_cached_prompt_pwd _prompt_bryndin_has_cached_pwd \
    _prompt_bryndin_filler_width _prompt_bryndin_overflow \
    _prompt_bryndin_monochrome _prompt_bryndin_cmd_start \
    _prompt_bryndin_duration_text _prompt_bryndin_git _prompt_bryndin_venv \
    _prompt_bryndin_time _prompt_bryndin_async _prompt_bryndin_has_git_block \
    _prompt_bryndin_has_venv_block _prompt_bryndin_has_time_block \
    _prompt_bryndin_last_status _prompt_bryndin_status_text \
    _prompt_bryndin_status_dismissed _prompt_bryndin_installed \
    _prompt_bryndin_trapwinch_installed _prompt_bryndin_had_trapwinch \
    _prompt_bryndin_saved_trapwinch _prompt_bryndin_had_managed \
    _prompt_bryndin_saved_managed _prompt_bryndin_last_pwd \
    _prompt_bryndin_git_root
}

function prompt_bryndin_build_host_block_reply {
  emulate -L zsh
  local show_host=0 show_user=1
  prompt_bryndin_is_remote && show_host=1

  case $_prompt_bryndin_conf[user] in
    no|never|false|off|0) show_user=0 ;;
    auto) (( EUID == 0 || show_host )) || show_user=0 ;;
  esac

  if (( ! show_user && ! show_host )); then
    REPLY=''
    return 0
  fi

  local main_fg=${_prompt_bryndin_fg[main-color]}
  local host_fg=${_prompt_bryndin_fg[host-color]}
  local err_fg=${_prompt_bryndin_fg[error-color]}
  local reset_fg=${_prompt_bryndin_fg[reset]}
  local max=${_prompt_bryndin_conf[max-block-width]:-0}
  [[ $max == <-> ]] || max=0

  if (( max > 0 )); then
    local raw=''
    (( show_user )) && raw+=${(%):-%n}
    (( show_user && show_host )) && raw+='@'
    (( show_host )) && raw+=${(%):-%m}
    if (( ${(m)#raw} > max )); then
      prompt_bryndin_clip_reply "$raw" "$max"
      local clipped=${REPLY//\%/%%}
      local user_fg="%(!.${err_fg}.${host_fg})"
      (( ! show_user )) && user_fg=$host_fg
      REPLY="${main_fg}─(${user_fg}${clipped}${main_fg})${reset_fg}"
      return 0
    fi
  fi

  local inner=''
  (( show_user )) && inner+="%(!.${err_fg}.${host_fg})%n${reset_fg}"
  if (( show_host )); then
    local sep=''
    (( show_user )) && sep='@'
    inner+="${host_fg}${sep}%m${reset_fg}"
  fi
  REPLY="${main_fg}─(${inner}${main_fg})${reset_fg}"
}

function prompt_bryndin_setup {
  emulate -L zsh
  unsetopt LOCAL_TRAPS
  prompt_opts=(cr percent sp subst)

  prompt_bryndin_build_colors

  zmodload -F zsh/datetime p:EPOCHREALTIME 2>/dev/null
  autoload -Uz add-zsh-hook add-zle-hook-widget
  prompt_bryndin_has_prompt_pwd && autoload -Uz prompt-pwd

  precmd_functions=(prompt_bryndin_precmd_status ${precmd_functions:#prompt_bryndin_precmd_status})
  add-zsh-hook precmd prompt_bryndin_precmd
  add-zsh-hook preexec prompt_bryndin_preexec
  add-zle-hook-widget line-pre-redraw prompt_bryndin_line_pre_redraw

  if (( ! _prompt_bryndin_trapwinch_installed )); then
    if (( ${+functions[TRAPWINCH]} )); then
      _prompt_bryndin_had_trapwinch=1
      _prompt_bryndin_saved_trapwinch=$functions[TRAPWINCH]
      functions[_prompt_bryndin_user_trapwinch]=$functions[TRAPWINCH]
    else
      _prompt_bryndin_had_trapwinch=0
      _prompt_bryndin_saved_trapwinch=''
      unfunction _prompt_bryndin_user_trapwinch 2>/dev/null
    fi
    TRAPWINCH() { prompt_bryndin_resize }
    _prompt_bryndin_trapwinch_installed=1
  fi

  if (( ! _prompt_bryndin_installed )); then
    if zstyle -s ':prezto:module:prompt' managed _prompt_bryndin_saved_managed; then
      _prompt_bryndin_had_managed=1
    else
      _prompt_bryndin_had_managed=0
      _prompt_bryndin_saved_managed=''
    fi
    _prompt_bryndin_installed=1
  fi
  zstyle ':prezto:module:prompt' managed 'yes'
  (( ${+functions[prompt_cleanup]} )) && \
    prompt_cleanup 'prompt_bryndin_teardown' 2>/dev/null

  local c_red='' c_green='' c_yellow='' c_blue='' c_magenta='' c_cyan='' c_white='' c_off=''
  if (( _prompt_bryndin_monochrome )); then
    zstyle ':prezto:module:editor:info:completing' format '...'
    zstyle ':prezto:module:editor:info:keymap:primary' format '❯❯❯'
    zstyle ':prezto:module:editor:info:keymap:primary:overwrite' format ' ♺'
    zstyle ':prezto:module:editor:info:keymap:alternate' format '❮❮❮'
  else
    c_red='%F{red}' c_green='%F{green}' c_yellow='%F{yellow}' c_blue='%F{blue}'
    c_magenta='%F{magenta}' c_cyan='%F{cyan}' c_white='%F{white}' c_off='%f'
    zstyle ':prezto:module:editor:info:completing' format '%B%F{red}...%f%b'
    zstyle ':prezto:module:editor:info:keymap:primary' format '%B%F{red}❯%F{yellow}❯%F{green}❯%f%b'
    zstyle ':prezto:module:editor:info:keymap:primary:overwrite' format ' %F{red}♺%f'
    zstyle ':prezto:module:editor:info:keymap:alternate' format '%B%F{green}❮%F{yellow}❮%F{red}❮%f%b'
  fi

  zstyle ':prezto:module:git:info' verbose 'yes'
  zstyle ':prezto:module:git:info:action' format ":%%B${c_yellow}%s${c_off}%%b"
  zstyle ':prezto:module:git:info:added' format " %%B${c_green}✚${c_off}%%b"
  zstyle ':prezto:module:git:info:ahead' format " %%B${c_yellow}⬆${c_off}%%b"
  zstyle ':prezto:module:git:info:behind' format " %%B${c_yellow}⬇${c_off}%%b"
  zstyle ':prezto:module:git:info:branch' format '%b'
  zstyle ':prezto:module:git:info:commit' format '%.7c'
  zstyle ':prezto:module:git:info:deleted' format " %%B${c_red}✖${c_off}%%b"
  zstyle ':prezto:module:git:info:modified' format " %%B${c_blue}✱${c_off}%%b"
  zstyle ':prezto:module:git:info:position' format '%p'
  zstyle ':prezto:module:git:info:renamed' format " %%B${c_magenta}→${c_off}%%b"
  zstyle ':prezto:module:git:info:stashed' format " %%B${c_cyan}✭${c_off}%%b"
  zstyle ':prezto:module:git:info:unmerged' format " %%B${c_red}═${c_off}%%b"
  zstyle ':prezto:module:git:info:untracked' format " %%B${c_white}◼${c_off}%%b"

  local main_fg=${_prompt_bryndin_fg[main-color]}
  local reset_fg=${_prompt_bryndin_fg[reset]}
  zstyle ':prezto:module:git:info:keys' format \
    'bryndin-git-prefix' "${main_fg}─(${_prompt_bryndin_fg[git-color]}git${reset_fg}" \
    'bryndin-git-suffix' "%s%A%B%S%a%d%m%r%U%u${main_fg})${reset_fg}" \
    'bryndin-branch' '%b' \
    'bryndin-position' '%p' \
    'bryndin-commit' '%c'

  # Prevent plain `venv` activate scripts from prepending `(.venv) ` to $PS1.
  export VIRTUAL_ENV_DISABLE_PROMPT="${VIRTUAL_ENV_DISABLE_PROMPT:-20}"
  zstyle ':prezto:module:python:info:virtualenv' format \
    "${main_fg}─<${_prompt_bryndin_fg[virtualenv-color]}%v${main_fg}>${reset_fg}"

  local max=${_prompt_bryndin_conf[max-block-width]:-0}
  local time_inner=$_prompt_bryndin_conf[time-format]
  [[ $max == <-> ]] && (( max > 0 )) && time_inner='${_prompt_bryndin_time}'
  local time_block="${main_fg}─(${_prompt_bryndin_fg[time-color]}${time_inner}${main_fg})${reset_fg}"

  prompt_bryndin_build_host_block_reply
  local host_block=$REPLY
  local git_block='${_prompt_bryndin_git}'
  local virtualenv_block='${_prompt_bryndin_venv}'
  local dir_block="${main_fg}[${_prompt_bryndin_fg[dir-color]}"'${_prompt_bryndin_cur_dir}'"${main_fg}]─${reset_fg}"

  _prompt_bryndin_block_text=()
  _prompt_bryndin_left=''
  local block
  for block in $_prompt_bryndin_blocks; do
    case $block in
      time)       _prompt_bryndin_block_text[time]=$time_block ;;
      host)       _prompt_bryndin_block_text[host]=$host_block ;;
      virtualenv) _prompt_bryndin_block_text[virtualenv]=$virtualenv_block ;;
      git)        _prompt_bryndin_block_text[git]=$git_block ;;
    esac
    _prompt_bryndin_left+=$_prompt_bryndin_block_text[$block]
  done
  _prompt_bryndin_right=$dir_block

  local overwrite_seg=''
  [[ $_prompt_bryndin_conf[overwrite] == yes ]] && overwrite_seg='${editor_info[overwrite]}'
  if [[ $_prompt_bryndin_conf[keymap-indicator] == yes ]]; then
    PROMPT="%(!.%B${_prompt_bryndin_fg[error-color]}#${reset_fg}%b .)"'${editor_info[keymap]}'"${overwrite_seg} "
  else
    PROMPT="%(!.%B${_prompt_bryndin_fg[error-color]}#${reset_fg}%b.%B${_prompt_bryndin_fg[main-color]}❯${reset_fg}%b)${overwrite_seg} "
  fi

  if [[ $_prompt_bryndin_conf[single-line] != yes ]]; then
    local newline="${prompt_newline:-$'\n'}"
    PROMPT='${_prompt_bryndin_header}'"${newline}${PROMPT}"
  fi

  if (( _prompt_bryndin_monochrome )); then
    SPROMPT='zsh: correct %R to %r [nyae]? '
  else
    SPROMPT='zsh: correct %F{red}%R%f to %F{green}%r%f [nyae]? '
  fi

  RPROMPT=''
  [[ $_prompt_bryndin_conf[exit-status] == yes ]] && \
    RPROMPT='${_prompt_bryndin_status_text}'
  [[ $_prompt_bryndin_conf[jobs] == yes ]] && \
    RPROMPT+="%(1j. ${main_fg}[%j&]${reset_fg}.)"
  [[ $_prompt_bryndin_conf[history] == yes ]] && \
    RPROMPT+=" ${main_fg}!%!${reset_fg}"
  [[ $_prompt_bryndin_conf[duration] == yes ]] && \
    RPROMPT+='${_prompt_bryndin_duration_text}'
  [[ $_prompt_bryndin_conf[vim] == yes ]] && \
    RPROMPT+='${VIM:+" %BV'"${reset_fg}"'%b"}'

  # Restart any previous async worker so updated zstyles take effect, and only
  # start one when the header and `git` block are actually enabled.
  (( ${+functions[async_stop_worker]} )) && async_stop_worker prompt_bryndin 2>/dev/null
  _prompt_bryndin_async=0
  if [[ $_prompt_bryndin_conf[async] == yes &&
        $_prompt_bryndin_conf[single-line] != yes &&
        -z ${_prompt_bryndin_preview:-} ]] &&
     (( _prompt_bryndin_has_git_block )); then
    local dir async_file=''
    for dir in $fpath; do
      [[ -r $dir/async ]] && { async_file=$dir/async; break }
    done
    if [[ -n $async_file ]]; then
      autoload -Uz async && async
      if (( ${+functions[async_start_worker]} )) &&
         async_start_worker prompt_bryndin -n -u; then
        async_register_callback prompt_bryndin prompt_bryndin_async_callback
        _prompt_bryndin_async=1
      fi
    fi
  fi
}

prompt_bryndin_setup "$@"
# vim: ft=zsh
